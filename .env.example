DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=grating_sejahterah
# Gunakan 1 untuk TiDB Cloud atau MySQL yang mewajibkan TLS.
DB_SSL=0
# Opsional. Isi sertifikat CA jika penyedia memakai CA khusus.
DB_SSL_CA=
DEMO_MODE=1
ADMIN_USERNAME=admin
# Isi dengan kata sandi pilihan sendiri, minimal 12 karakter.
ADMIN_PASSWORD=
# Nomor internasional tanpa tanda tambah. Wajib untuk RFQ produksi.
SALES_WHATSAPP=
# Aktifkan jika aplikasi diakses melalui HTTPS.
COOKIE_SECURE=0
